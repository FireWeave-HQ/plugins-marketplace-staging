{
  "name": "@fireweaveai/rollout-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "MCP server exposing rollout-skill tools to Claude Code and compatible agents.",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "rollout-server": "dist/server.js"
  },
  "scripts": {
    "build": "bun build src/server.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint:exports": "bash scripts/lint-exports.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@fireweaveai/contracts": "../../../../../../contracts",
    "@fireweaveai/deploy-sdk": "../../../../../../deploy-sdk",
    "@fireweaveai/diff-surface": "../../../../../../diff-surface",
    "simple-git": "^3.27.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/bun": "^1.3.11"
  }
}
